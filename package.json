{
  "name": "decky-wifi-toggle",
  "version": "0.1.0",
  "description": "Pause Steam downloads on a chosen Wi-Fi network",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests && node --experimental-strip-types --test tests/controller.test.ts",
    "package": "pnpm build && python3 scripts/package.py"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "wifi",
    "downloads"
  ],
  "author": "Drew",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "cpu": [
        "arm64",
        "x64"
      ],
      "libc": [
        "glibc",
        "musl"
      ],
      "os": [
        "darwin",
        "linux"
      ]
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.6.0"
  }
}
